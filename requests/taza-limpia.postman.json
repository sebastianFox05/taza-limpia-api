{
  "info": {
    "name": "Taza Limpia API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "email", "value": "cata@tazalimpia.test" },
    { "key": "password", "value": "" },
    { "key": "token", "value": "" },
    { "key": "coffeeId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Catalogo",
      "request": { "method": "GET", "url": "{{baseUrl}}/coffees" }
    },
    {
      "name": "Catalogo con operadores",
      "request": { "method": "GET", "url": "{{baseUrl}}/coffees?process=lavado,natural&minScore=88&sort=altitude" }
    },
    {
      "name": "Estadisticas",
      "request": { "method": "GET", "url": "{{baseUrl}}/stats" }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{ \"email\": \"{{email}}\", \"password\": \"{{password}}\" }" }
      }
    },
    {
      "name": "Crear cafe",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.collectionVariables.set('coffeeId', pm.response.json().coffee._id);"] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/coffees",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cajamarca lavado\",\n  \"country\": \"Perú\",\n  \"region\": \"Cajamarca\",\n  \"variety\": \"Typica\",\n  \"process\": \"lavado\",\n  \"roast\": \"medio\",\n  \"altitude\": 1800,\n  \"score\": 85,\n  \"notes\": [\"cacao\", \"nuez\"],\n  \"description\": \"Café de los Andes del norte de Perú, dulce y de acidez suave.\"\n}"
        }
      }
    },
    {
      "name": "Editar cafe",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/coffees/{{coffeeId}}",
        "body": { "mode": "raw", "raw": "{ \"score\": 86 }" }
      }
    },
    {
      "name": "Eliminar cafe",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/coffees/{{coffeeId}}" }
    },
    {
      "name": "Historial del panel",
      "request": { "method": "GET", "url": "{{baseUrl}}/stats/activity" }
    }
  ]
}
